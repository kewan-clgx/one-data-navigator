{
  "manifest_version": 3,
  "name": "EasyQuery Collibra Bridge",
  "version": "0.4.0",
  "description": "Lets EasyQuery read the Collibra catalog with your own Collibra browser session. Read-only; nothing is stored by EasyQuery.",
  "permissions": ["storage"],
  "host_permissions": ["https://*.collibra.com/*"],
  "optional_host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["https://easyquery.ai/*", "http://localhost:3100/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "options_page": "options.html",
  "action": { "default_title": "EasyQuery Collibra Bridge", "default_popup": "options.html" }
}
