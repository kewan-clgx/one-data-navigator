# Production settings for the VM (copied to /opt/odn/.env by deploy/deploy.sh --env <file>).
# Never commit the filled-in copy. Generate secrets with: openssl rand -hex 32
# (hex keeps them URL-safe for the database URLs). ODN_SESSION_SECRET is different: see below.

# --- Public endpoint -------------------------------------------------------------------------
# The app (signed-out visitors see the marketing page at /, sign-in is /signin). docs/config/plan_to_easyquery.md
ODN_HOSTNAME=easyquery.ai
# Optional separate website host (home + privacy + terms; other paths go to the app). Empty = none.
ODN_SITE_HOSTNAME=
# Public Insight Wall host (optional; the wall is always at <app>/insights too).
ODN_INSIGHTS_HOSTNAME=insights.easyquery.ai
# Hosts that permanently redirect to the website, or the app if there's no website (path kept). Separate with ", "
# (comma AND space). Each needs DNS to the VM.
ODN_REDIRECT_HOSTS=www.easyquery.ai, app.easyquery.ai, querymuse.ai, www.querymuse.ai
# Old app / wall hosts after a domain move: redirect to the new ones, path kept (share links, emails, bookmarks).
ODN_LEGACY_APP_HOSTS=app.querymuse.ai
ODN_LEGACY_INSIGHTS_HOSTS=insights.querymuse.ai
# Support address shown in the app, website and emails (also the emails' Reply-To).
ODN_SUPPORT_EMAIL=support@easyquery.ai
# Let's Encrypt account / expiry notices.
ACME_EMAIL=

# --- Google sign-in (OAuth client: Web application, redirect https://<ODN_HOSTNAME>/auth/callback)
ODN_OIDC_CLIENT_ID=
ODN_OIDC_CLIENT_SECRET=
# Tenants, domains and sign-in mappings live in the database: python -m odn.db.provision (see docs).
# Who may use the fallback tenant for personal Google accounts (provision idp <tenant> https://accounts.google.com '*'):
# comma-separated emails or @domain entries. Empty = any Google account.
ODN_OIDC_DEFAULT_TENANT_EMAILS=
# 32 random bytes, base64url: openssl rand 32 | base64 | tr '+/' '-_' | tr -d '='
ODN_SESSION_SECRET=

# --- Postgres (container on the VM; passwords applied on first init only) ---------------------
ODN_DB_OWNER_PASSWORD=
ODN_APP_DB_PASSWORD=
ODN_AGENT_DB_PASSWORD=

# --- Encryption of user-supplied credentials (Settings: connection keys, LLM keys) ------------
# 32 random bytes, base64url (same command as ODN_SESSION_SECRET). Back it up: if it is lost or
# changed, every saved user key becomes unreadable and users must enter them again.
ODN_SECRETS_KEY=

# --- Internal service tokens ------------------------------------------------------------------
ODN_WORKER_TOKEN=
ODN_AGENT_TOKEN=

# --- Result workspace (VM service account needs object access on this bucket) -----------------
ODN_GCS_BUCKET=datahop
ODN_GCS_PREFIX=odn

# --- LLM: Gemini API (AI Studio key) via LiteLLM ----------------------------------------------
LITELLM_MODEL=gemini/gemini-3.5-flash
LITELLM_API_KEY=
# Only for an OpenAI-compatible proxy; leave empty for gemini/ models.
LITELLM_API_BASE=

# --- Guardrails (optional overrides) ----------------------------------------------------------
# Shared platform key: per-tenant daily limit, and each user's free trial before they must add their own key.
# ODN_LLM_DAILY_TOKEN_BUDGET=2000000
# ODN_LLM_TRIAL_USER_DAILY_TOKENS=200000
# ODN_CONFIRM_BYTES_THRESHOLD=10737418240

# Password sign-in tenants (docs/Tenant_Isolation_User_system.md). Project with Identity Platform enabled and
# the API key restricted to identitytoolkit + securetoken (gcloud services api-keys get-key-string ...).
ODN_IDP_PROJECT=datahop-514819
ODN_IDP_API_KEY=

# Branded invite/reset emails from noreply@easyquery.ai via Resend (domain verified in Resend). The key lives in
# Secret Manager (VM service account reads it); leave empty to use Identity Platform's own emails.
ODN_RESEND_API_KEY_SECRET=projects/datahop-514819/secrets/odn-resend-api-key/versions/latest
# Sender (the domain must be verified in Resend and allowed for the key).
ODN_MAIL_FROM=EasyQuery <noreply@easyquery.ai>

# Collibra catalog (docs/collibra_int_phase5_plan.md): RSA private key (PEM) in Secret Manager that signs per-user
# Collibra tokens. Create once: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:3072 | gcloud secrets create
# odn-collibra-signing-key --data-file=- . Collibra trusts https://<ODN_HOSTNAME>/.well-known/jwks.json.
ODN_COLLIBRA_SIGNING_KEY_SECRET=projects/datahop-514819/secrets/odn-collibra-signing-key/versions/latest
