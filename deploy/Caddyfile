# Public entry point: automatic Let's Encrypt TLS for ODN_HOSTNAME, proxied to the Next.js BFF.
# The API, agent, worker and Postgres are only reachable on the internal Docker network.
{
	email {$ACME_EMAIL}
}

{$ODN_HOSTNAME} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	reverse_proxy frontend:3000
}

# Apex/www (ODN_REDIRECT_HOSTS, comma-separated) -> the app. Unset or empty means localhost, which
# needs no public certificate, so the block is harmless.
{$ODN_REDIRECT_HOSTS:localhost} {
	redir https://{$ODN_HOSTNAME}{uri} permanent
}
