# Public entry point: automatic Let's Encrypt TLS for ODN_HOSTNAME, proxied to the Next.js BFF.
# The API, agent, worker and Postgres are only reachable on the internal Docker network.
{
	email {$ACME_EMAIL}
}

(security_headers) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

{$ODN_HOSTNAME} {
	import security_headers
	reverse_proxy frontend:3000
}

# Public website (ODN_SITE_HOSTNAME, e.g. www.querymuse.ai): home page and privacy policy, served by the same
# frontend; any other path belongs to the app. Unset means site.localhost (no public certificate needed).
{$ODN_SITE_HOSTNAME:site.localhost} {
	import security_headers
	@app not path / /site /privacy /_next/*
	redir @app https://{$ODN_HOSTNAME}{uri}
	rewrite / /site
	reverse_proxy frontend:3000
}

# Other hostnames (ODN_REDIRECT_HOSTS, comma-separated, e.g. the apex) -> the website, else the app.
# Unset or empty means localhost, which needs no public certificate, so the block is harmless.
{$ODN_REDIRECT_HOSTS:localhost} {
	redir https://{$ODN_REDIRECT_TARGET}{uri} permanent
}
