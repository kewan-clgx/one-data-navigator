# Public entry point: automatic Let's Encrypt TLS for ODN_HOSTNAME, proxied to the Next.js BFF.
# The API, agent, worker and Postgres are only reachable on the internal Docker network.
{
	email {$ACME_EMAIL}
}

(security_headers) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

{$ODN_HOSTNAME} {
	import security_headers
	reverse_proxy frontend:3000
}

# Public website (ODN_SITE_HOSTNAME, e.g. www.example.ai): home page and privacy policy, served by the same
# frontend; any other path belongs to the app. Unset means site.localhost (no public certificate needed).
{$ODN_SITE_HOSTNAME:site.localhost} {
	import security_headers
	@app not path / /site /privacy /terms /_next/*
	redir @app https://{$ODN_HOSTNAME}{uri}
	rewrite / /site
	reverse_proxy frontend:3000
}

# Public Insight Wall (ODN_INSIGHTS_HOSTNAME, e.g. insights.easyquery.ai): the public wall, rendered by the same
# frontend without the app's session; report pages (/s/...), sign-in and voting belong to the app. Unset means
# insights.localhost (no public certificate needed).
{$ODN_INSIGHTS_HOSTNAME:insights.localhost} {
	import security_headers
	@app not path / /insights /_next/*
	redir @app https://{$ODN_HOSTNAME}{uri}
	rewrite / /insights
	reverse_proxy frontend:3000
}

# Other hostnames (ODN_REDIRECT_HOSTS, separated by ", " — comma AND space, e.g. "www.x.ai, app.x.ai") -> the website, else the app.
# Unset or empty means localhost, which needs no public certificate, so the block is harmless.
{$ODN_REDIRECT_HOSTS:localhost} {
	redir https://{$ODN_REDIRECT_TARGET}{uri} permanent
}

# Old hosts after a domain move (ODN_LEGACY_APP_HOSTS / ODN_LEGACY_INSIGHTS_HOSTS, separated by ", ", e.g.
# app.querymuse.ai / insights.querymuse.ai): permanent redirect to the new app / wall host, path and query kept,
# so share links, set-password emails and bookmarks keep working. Unset means *.localhost (inert).
{$ODN_LEGACY_APP_HOSTS:legacy-app.localhost} {
	redir https://{$ODN_HOSTNAME}{uri} permanent
}

{$ODN_LEGACY_INSIGHTS_HOSTS:legacy-insights.localhost} {
	redir https://{$ODN_INSIGHTS_HOSTNAME}{uri} permanent
}
