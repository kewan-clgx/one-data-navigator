# Copy to .env (gitignored) and fill in. Loaded by the api and agent containers.

# BigQuery. Put the service-account JSON under ./keys/ (gitignored); path is relative to the repo root.
BQ_SA_KEY_FILE=keys/<service-account>.json
# Project used for BigQuery jobs (billing) and default dataset for local testing.
BQ_PROJECT_ID=
# Comma-separated dataset ids the local connection may query, or * for every dataset in BQ_PROJECT_ID (also the default when empty).
BQ_DATASET_IDS=
# Specific tables/views: dataset.table, comma list or quoted "( ... )" block. A dataset named here allows only its listed tables.
BQ_TABLES=

# Result-workspace bucket (used with docker-compose.gcs.yml). Separate service account from BigQuery.
GCS_SA_KEY_FILE=keys/<datahop-service-account>.json
ODN_GCS_BUCKET=datahop
ODN_GCS_PREFIX=odn

# Managed LLM (platform key) via the LiteLLM proxy (OpenAI-compatible). Loaded by the agent only.
LITELLM_API_BASE=
LITELLM_API_KEY=
LITELLM_MODEL=openai/<model-name>

# Per-tenant daily LLM budget (tokens, prompt + completion, UTC day) for the managed key; the agent stops at the limit.
ODN_LLM_DAILY_TOKEN_BUDGET=2000000
# Shared secret the agent uses to report LLM usage to the API (set a random value outside local dev).
ODN_AGENT_TOKEN=

# Dry-run cost threshold above which a confirmation card is required (bytes).
ODN_CONFIRM_BYTES_THRESHOLD=10737418240

# Password sign-in tenants via Google Identity Platform (optional; empty = disabled).
ODN_IDP_PROJECT=
ODN_IDP_API_KEY=
# Personal email/password accounts: tenant slug (provision tenant <slug> --join domain --create-idp-tenant).
ODN_PERSONAL_TENANT=
# Live demo: tenant slug (provision tenant demo ...; provision demo demo --max-gb 25).
ODN_DEMO_TENANT=
# Email for every new demo visitor (empty = none).
ODN_DEMO_NOTIFY_EMAIL=
